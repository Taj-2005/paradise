# ─────────────────────────────────────────────────────────────────────────────
#  CN Phase 1 — single source of truth for every machine, config and script.
#
#  1. cp .env.example .env
#  2. Edit the values below to match your actual LAN.
#  3. ./scripts/render-configs.sh      # regenerates dnsmasq.conf + nginx confs
#
#  Nothing else in this repo hardcodes an IP address. If you change an IP,
#  change it HERE and re-render — never edit a generated config by hand.
# ─────────────────────────────────────────────────────────────────────────────

# ── Team identity ────────────────────────────────────────────────────────────
# TEAM drives your private domain. Change this one value to rename everything.
# MUST use the .test TLD — .local collides with macOS mDNS (spec §3).
TEAM=paradise
APP_DOMAIN=app.paradise.test
API_DOMAIN=api.paradise.test

# ── Machine IPs (private IPv4 on your LAN) ───────────────────────────────────
# Find yours with:  ipconfig getifaddr en0
DNS_IP=192.168.1.10          # Mac 1 — dnsmasq  + test client
EDGE_IP=192.168.1.11         # Mac 2 — nginx reverse proxy / load balancer
BACKEND_A_IP=192.168.1.12    # Mac 3 — Backend A
BACKEND_B_IP=192.168.1.13    # Mac 4 — Backend B + test client

# ── Network interface ────────────────────────────────────────────────────────
# Wi-Fi is almost always en0 on macOS; Ethernet/dongle is often en5..en8.
# Confirm with:  route get default | awk '/interface:/{print $2}'
IFACE=en0
# The name macOS uses in Network Settings, for `networksetup` calls.
# Confirm with:  networksetup -listallnetworkservices
NET_SERVICE=Wi-Fi

# ── Ports ────────────────────────────────────────────────────────────────────
# Spec §3 allows 8080/8443 instead of 80/443 with NO marks deducted if your
# machine will not let nginx bind to privileged ports. Pick one and stay
# consistent — the domain in every curl must match the port you chose.
#   Privileged (needs sudo nginx):   HTTP_PORT=80   HTTPS_PORT=443
#   Unprivileged (no sudo needed):   HTTP_PORT=8080 HTTPS_PORT=8443
HTTP_PORT=80
HTTPS_PORT=443

BACKEND_A_PORT=3001
BACKEND_B_PORT=3002

# ── DNS behaviour ────────────────────────────────────────────────────────────
# TTL 0 keeps Phase 1 demos deterministic (no stale cached answers mid-demo).
# Phase 2 Extension B will raise this to 30 to demonstrate TTL caching.
DNS_TTL=0
# Where dnsmasq forwards names it does not own (public internet resolution).
UPSTREAM_DNS=1.1.1.1

# ── Caching (Task F) ─────────────────────────────────────────────────────────
CACHE_MAX_AGE=60
