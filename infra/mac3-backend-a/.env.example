# Mac 3 — Backend A
#
# You do NOT normally need this file. run.sh reads the repo-root .env and sets
# everything for you. This exists only for starting the service by hand while
# troubleshooting:
#
#   cd services/backend
#   env $(grep -v '^#' ../../infra/mac3-backend-a/.env.example | xargs) npm start

BACKEND_ID=A
PORT=3001
HOST=0.0.0.0
CACHE_MAX_AGE=60
TEAM=paradise
