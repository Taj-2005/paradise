# ─────────────────────────────────────────────────────────────────────────────
#  CN Phase 2 — OPTIONAL overrides.   cp infra/phase2/.env.phase2.example infra/phase2/.env.phase2
#
#  Phase 2 reuses the Phase 1 .env (repo root) for every IP, port and name.
#  You only need this file to change a Phase 2 default. Without it:
#     BACKUP_DNS_IP   = BACKEND_B_IP  (Mac 4)
#     STANDBY_EDGE_IP = BACKEND_B_IP  (Mac 4)
#     P2_DNS_TTL      = 30
#     HEALTH_INTERVAL = 2
# ─────────────────────────────────────────────────────────────────────────────

# Ext A — second resolver. Any Mac except Mac 1, with port 53 free.
#BACKUP_DNS_IP=192.168.1.13

# Ext E — standby nginx edge. Any Mac except Mac 2. May share a Mac with the
# backup DNS (default: both on Mac 4) — dnsmasq uses :53, nginx :80/:443.
#STANDBY_EDGE_IP=192.168.1.13

# Ext B — TTL served on the project records, in seconds. Long enough to watch,
# short enough to wait out on camera.
#P2_DNS_TTL=30

# Ext D — seconds between health polls in `make p2-health-watch`.
#HEALTH_INTERVAL=2
