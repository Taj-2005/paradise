# Mac 4 — Backend B
#
# You do NOT normally need this file. run.sh reads the repo-root .env and sets
# everything for you. This exists only for starting the service by hand while
# troubleshooting:
#
#   cd services/backend
#   env $(grep -v '^#' ../../infra/mac4-backend-b/.env.example | xargs) npm start

BACKEND_ID=B
PORT=3002
HOST=0.0.0.0
CACHE_MAX_AGE=60
TEAM=paradise
